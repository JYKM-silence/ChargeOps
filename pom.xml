<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.chargeops</groupId>
    <artifactId>chargeops</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ChargeOps</name>
    <description>新能源充电桩运营平台</description>

    <!--
      单模块，不是老库的三模块：多模块下改了 sky-common 要 mvn install 才能被
      sky-server 看到，顺序错了就报「找不到符号」，而真实原因是没装到本地仓库。

      Boot 的 BOM（spring-boot-dependencies）代管了下面几个，故意不写版本号：
      mysql-connector-j、lombok、spring-security-crypto。properties 里写的版本，
      是 BOM 管不到、必须自己钉住的第三方组件。
    -->

    <properties>
        <java.version>21</java.version>

        <!-- BOM 管不到，必须自己钉；每一项都已从 Maven Central 实测核实 -->
        <mybatis-spring-boot.version>4.1.0</mybatis-spring-boot.version>
        <pagehelper.version>4.1.1</pagehelper.version>
        <druid.version>1.2.28</druid.version>
        <springdoc.version>3.1.1</springdoc.version>
        <jjwt.version>0.12.7</jjwt.version>
        <poi.version>5.5.1</poi.version>
    </properties>

    <dependencies>

        <!-- ==================== Web ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          参数校验（@NotNull / @Min / @Pattern）：脏数据要在进 Service 之前就被
          拦下来返回 400，而不是靠 Service 里随手写 if 判断。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
          这里故意没有 spring-boot-starter-aop / starter-aspectj。自动填充最初
          写成 @Aspect 切面，结果是切点匹配、启动零报错，但一次都没触发过 ——
          MyBatis 的 Mapper 由 MapperFactoryBean 生产，不经过 BeanPostProcessor，
          Spring AOP 没有机会织入。填充现改由 MyBatis 插件 AutoFillInterceptor 实现。

          Boot 4 里它改名成了 spring-boot-starter-aspectj（名字里不再有 "aop"，按
          老名字敲会报 'dependencies.dependency.version' is missing，真正的含义是
          BOM 不认识这个坐标）；删掉它不影响 @Transactional，缺的只有 @AspectJ 风格的切面。
        -->

        <!-- ==================== 数据层 ==================== -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>

        <!--
          PageHelper 必须排除它传递进来的 mybatis-spring-boot-starter：
          pagehelper-spring-boot-starter 自己声明了这条依赖，上面又显式引了
          4.1.0，两个版本打架的结果可能是 SqlSessionFactory 装配失败，
          也可能是分页静默失效（SQL 里没拼 LIMIT，但接口照常返回数据，不报错）。

          验证命令：mvn dependency:tree -Dincludes=org.mybatis.spring.boot
        -->
        <dependency>
            <groupId>com.github.pagehelper</groupId>
            <artifactId>pagehelper-spring-boot-starter</artifactId>
            <version>${pagehelper.version}</version>
            <exclusions>
                <exclusion>
                    <groupId>org.mybatis.spring.boot</groupId>
                    <artifactId>mybatis-spring-boot-starter</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!--
          Druid 连接池。artifactId 里的 "-4-" 是重点：Boot 4 用 jakarta.servlet，
          无后缀的 druid-spring-boot-starter 和 druid-spring-boot-3-starter
          都绑 javax.servlet。引错了编译期不报错，启动时炸
          java.lang.ClassNotFoundException: javax.servlet.Filter
          —— 这个错看起来像「少了 servlet-api」，实际是版本错配。
        -->
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-4-starter</artifactId>
            <version>${druid.version}</version>
        </dependency>

        <!-- MySQL 驱动：坐标是 com.mysql:mysql-connector-j（老库用的 mysql:mysql-connector-java 已废弃） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          数据库迁移。必须是 spring-boot-starter-flyway，不是裸的 flyway-core：
          Boot 4 把 Flyway 的自动配置拆成了独立模块，只引 flyway-core 的后果是
          jar 在 classpath 上，但没有任何东西会去读 db/migration —— 没有报错、
          没有日志，启动一切正常，而迁移一条都没跑，看起来却是成功的。

          三个坐标都不写版本号，由 Boot 的 BOM 统一管理。

          必须单独引 flyway-mysql：Flyway 9 之后 MySQL 的方言包不在 flyway-core
          里（BOM 里的坐标就叫 flyway-mysql），缺了它启动时报
          "Unsupported Database: MySQL 8.4"，看起来像「不支持这个版本」。

          验证命令：mvn dependency:tree -Dincludes=org.flywaydb
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- ==================== Redis ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          连接池。spring-boot-starter-data-redis 只引入 lettuce 核心，没有
          commons-pool2 的话 lettuce 只能用一个共享连接，枪状态高频读写时会成为
          瓶颈；加上它之后 spring.data.redis.lettuce.pool.* 才会生效。
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ==================== 密码加密 ==================== -->
        <!--
          只引 spring-security-crypto 这一个包，绝不引 spring-boot-starter-security：
          crypto 只提供 BCrypt 这类纯算法，而 starter-security 会往容器里塞一整条
          过滤器链，效果是所有接口默认都要登录，返回 401 或跳转到 Spring 自带的
          那个登录页，排查时会以为是 JWT 拦截器配错了。

          版本由 Boot 的 spring-security-bom 统一管理，不写版本号。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <!-- ==================== 接口文档 ==================== -->
        <!--
          springdoc 替代 knife4j：knife4j 底层的 springfox 已停止维护多年，且和
          Spring Boot 2.6+ 的 PathPatternParser 冲突，老库为此在 application.yml 里
          挂的 spring.mvc.pathmatch.matching-strategy: ant_path_matcher 补丁会让
          整个应用的路径匹配退回旧实现。

          springdoc 原生跑在 PathPatternParser 上，读的是 OpenAPI 3 规范。
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- ==================== JWT ==================== -->
        <!--
          0.12.x 的 Keys.hmacShaKeyFor 会校验 HS256 要求密钥 ≥ 256 bit 即 32 字节，
          不够就抛 WeakKeyException；老库的默认密钥是 "itcast"（6 字节）和
          "itheima"（7 字节），直接拷过来必炸，而且报的是 500 不是 401。

          三件套缺一不可，运行时三个 jar 都要在：jjwt-api 编译期接口；
          jjwt-impl runtime 实现（scope=runtime，编译时看不到是正确的）；
          jjwt-jackson JSON 序列化，缺了会在签发时抛 UnsupportedJwtException。
        -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 报表导出 ==================== -->
        <!--
          用 poi-ooxml，但代码里一律用 SXSSFWorkbook 而不是 XSSFWorkbook：
          XSSF 把整个工作簿放在内存里，导几万行充电流水会直接 OOM，SXSSF 是流式写。
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- ==================== 可观测性 ==================== -->
        <!--
          P3 才正式用，但现在加上成本为零：P0 验收时 /actuator/health 能立刻
          告诉我们数据库和 Redis 连上没有。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ==================== 开发期 ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
          配置元数据处理器：编译期扫描 @ConfigurationProperties 类，生成
          META-INF/spring-configuration-metadata.json，application.yml 里敲
          "sky.jwt." 时才有提示。
          不加也能跑，区别是 Spring 对拼错的配置项静默忽略，不报错。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Boot 4 把 MockMvc / @WebMvcTest / TestRestTemplate 从
          spring-boot-starter-test 挪到了 spring-boot-starter-webmvc-test，
          不引这个的话 @WebMvcTest 会找不到注解。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- Lombok 只在编译期起作用，打进可执行 jar 没有意义，反而会让镜像变大 -->
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
