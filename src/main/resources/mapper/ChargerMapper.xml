<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chargeops.mapper.ChargerMapper">

    <!--
      ★ 没有 station_name：桩列表要显示站名，但那是 charger 表里没有的 ——
        由 Service 查完再调 StationMapper.listByIds 批量补上，不在这里 join。
        理由是职责：这个 Mapper 只负责 charger 一张表，加了 join 之后
        任何关于 station 的查询变化都会波及这里。
    -->
    <sql id="Base_Column_List">
        id, station_id, device_no, name, type, model, rated_power_kw, gun_count, status,
        last_heartbeat_time, firmware_version,
        create_time, update_time, create_user, update_user
    </sql>

    <select id="getById" resultType="com.chargeops.entity.Charger">
        SELECT
        <include refid="Base_Column_List"/>
        FROM charger
        WHERE id = #{id}
    </select>

    <!--
      ★ 和 StationMapper.listByIds 逐字同形。
        ★★ 这里**没有**对空集合的保护，SQL 层也做不出保护 ★★ ——
          `IN ()` 是语法错误，MyBatis 会拼出一个缺了括号体的 IN，
          MySQL 报 errno 1064，兜底 handler 把它变成「未知错误」。
          调用方必须先判空。理由见 ChargerMapper#listByIds 的注释。

      ★ 不要试图用 <if> 把空集合变成「不传就查全部」：
        **「这些桩都不存在」和「不过滤」是两件相反的事**，
        后者会返回全表的所有桩。
    -->
    <select id="listByIds" resultType="com.chargeops.entity.Charger">
        SELECT
        <include refid="Base_Column_List"/>
        FROM charger
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!--
      ★★ 凡是 NOT NULL 的列，实体里必须有值 —— 全列插入时 DDL 的 DEFAULT 不生效
        （DEFAULT 只在该列没出现在 INSERT 里时才生效），传 null 就是往 NOT NULL
        列里显式写 NULL，报 errno 1048。已真机验证过 NULL / DEFAULT 这一对行为。
        这个坑在集成测试里【连踩三次】（station.open_time、charger.rated_power_kw、
        charger.gun_count），说明它是「全列插入」和「DDL 写 DEFAULT」的系统性摩擦：
        **别把 DDL 的 DEFAULT 当成能被依赖的保证**，「不填会怎样」由 DTO 的字段
        初始值决定并写进 Swagger，DDL 的 DEFAULT 只留给手工 SQL 兜底。

      ★★ gun_count 在这里【必须显式给出】，而且 Service 应该给 0，不是 DDL 默认的 1。
        它的事实来源是 connector 表（冗余列）：刚建好的桩一把枪都没有，真实值是 0；
        默认值 1 是给「一桩一枪」省事的近似，代价是**列表页会显示一个不存在的枪**，
        一直到有人加枪或数枪才发现。「近似但错的值」不如「暂时不完整但正确」，
        第一把枪被加上时 refreshGunCount 会把它刷成精确值。
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO charger (station_id, device_no, name, type, model, rated_power_kw, gun_count, status,
                             last_heartbeat_time, firmware_version,
                             create_time, update_time, create_user, update_user)
        VALUES (#{stationId}, #{deviceNo}, #{name}, #{type}, #{model}, #{ratedPowerKw}, #{gunCount}, #{status},
                #{lastHeartbeatTime}, #{firmwareVersion},
                #{createTime}, #{updateTime}, #{createUser}, #{updateUser})
    </insert>

    <!--
      ★★ <b>两个字段被刻意排除，理由都是「改了会让别处的数据失真」：</b>

        1) <b>gun_count</b> —— 不是客户端能设的字段，只由 ConnectorService 在枪
           增删时调 refreshGunCount 重算。放进 <set> 就等于给冗余列开了第二条写入
           路径，而两条路径迟早不一致。（测试里专门传过 gun_count=99 验证这一点。）

        2) <b>station_id</b> —— 把桩挪到别的站点，它的每一把枪的 station_id 都还
           指着**老站点**，而「某站点所有枪」的查询直接走 connector 的那个冗余列
           （idx_connector_station_status），挪完之后会返回一批挂在不存在的站点
           关系下的枪。★ 这是本项目冗余列代价最大的一处：横跨两张表，要修必须
           charger 和它的全部 connector 同事务一起改 —— 那是一个独立的「搬迁」
           操作（要有自己的接口和审计），不是「按主键更新非空字段」顺带能做的事，
           所以这个字段<b>不在 DTO 里</b>，编译期就改不了。代价是桩登记错站点时
           只能删掉重建，而它的枪会变成孤儿，运维要先确认那根桩没有被在途订单占用。

      ★ status / type 是 Integer，判断只能写 != null。
    -->
    <update id="update">
        UPDATE charger
        <set>
            <if test="deviceNo != null and deviceNo != ''">device_no = #{deviceNo},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="type != null">type = #{type},</if>
            <if test="model != null and model != ''">model = #{model},</if>
            <if test="ratedPowerKw != null">rated_power_kw = #{ratedPowerKw},</if>
            <if test="status != null">status = #{status},</if>
            <if test="lastHeartbeatTime != null">last_heartbeat_time = #{lastHeartbeatTime},</if>
            <if test="firmwareVersion != null and firmwareVersion != ''">firmware_version = #{firmwareVersion},</if>
            update_time = #{updateTime},
            update_user = #{updateUser}
        </set>
        WHERE id = #{id}
    </update>

    <!--
      ★ ORDER BY id DESC，理由见 StationMapper.xml 里的同名注释。

      ★ stationId 精确匹配走 idx_charger_station_status 的第一列；
        deviceNo 用前缀匹配（LIKE 'xxx%'）而不是两侧加 % —— 设备号是运维报障时的
        搜索入口，前缀匹配能用上 uk_charger_device_no 索引，而 %xxx% 只能全表扫。
    -->
    <select id="page" resultType="com.chargeops.entity.Charger">
        SELECT
        <include refid="Base_Column_List"/>
        FROM charger
        <where>
            <if test="stationId != null">
                AND station_id = #{stationId}
            </if>
            <if test="deviceNo != null and deviceNo != ''">
                AND device_no LIKE CONCAT(#{deviceNo}, '%')
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>
