<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chargeops.mapper.ChargerMapper">

    <!--
       没有 station_name：桩列表要显示的站名由 Service 查完再调 StationMapper.listByIds
       批量补上，不在这里 join —— 这个 Mapper 只负责 charger 一张表。
    -->
    <sql id="Base_Column_List">
        id, station_id, device_no, name, type, model, rated_power_kw, gun_count, status,
        last_heartbeat_time, firmware_version,
        create_time, update_time, create_user, update_user
    </sql>

    <select id="getById" resultType="com.chargeops.entity.Charger">
        SELECT
        <include refid="Base_Column_List"/>
        FROM charger
        WHERE id = #{id}
    </select>

    <!--
       和 StationMapper.listByIds 一样，没有对空集合的保护，SQL 层也做不出保护：
       `IN ()` 是语法错误、errno 1064，调用方必须先判空（见 ChargerMapper#listByIds）。

       不要用 <if> 把空集合变成「不传就查全部」：「这些桩都不存在」和「不过滤」是
       两件相反的事。
    -->
    <select id="listByIds" resultType="com.chargeops.entity.Charger">
        SELECT
        <include refid="Base_Column_List"/>
        FROM charger
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!--
       凡是 NOT NULL 的列，实体里必须有值 —— 全列插入时 DDL 的 DEFAULT 不生效，传 null
       就是往 NOT NULL 列里显式写 NULL，报 errno 1048。这个坑在集成测试里连踩三次
       （station.open_time、charger.rated_power_kw、charger.gun_count），所以「不填会
       怎样」应该由 DTO 的字段初始值决定并写进 Swagger，DDL 的 DEFAULT 只留给手工 SQL。

       gun_count 在这里必须显式给出，而且 Service 应该给 0，不是 DDL 默认的 1：它的事实
       来源是 connector 表，刚建好的桩一把枪都没有。默认值 1 是「一桩一枪」的近似，
       代价是列表页会显示一个不存在的枪，直到第一把枪被加上时 refreshGunCount 把它
       刷成精确值。
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO charger (station_id, device_no, name, type, model, rated_power_kw, gun_count, status,
                             last_heartbeat_time, firmware_version,
                             create_time, update_time, create_user, update_user)
        VALUES (#{stationId}, #{deviceNo}, #{name}, #{type}, #{model}, #{ratedPowerKw}, #{gunCount}, #{status},
                #{lastHeartbeatTime}, #{firmwareVersion},
                #{createTime}, #{updateTime}, #{createUser}, #{updateUser})
    </insert>

    <!--
       两个字段被刻意排除，理由都是「改了会让别处的数据失真」：

        1) gun_count —— 只由 ConnectorService 在枪增删时调 refreshGunCount 重算。
           放进 <set> 就等于给冗余列开了第二条写入路径，两条路径迟早不一致。

        2) station_id —— 把桩挪到别的站点，它的每一把枪的 station_id 都还指着老站点，
           而「某站点所有枪」的查询直接走 connector 的那个冗余列，挪完之后会返回一批
           挂在不存在的站点关系下的枪。要修必须 charger 和它的全部 connector 同事务
           一起改，那是一个独立的「搬迁」操作，不是这里顺带能做的事 —— 所以这个字段
           不在 DTO 里，编译期就改不了。

       status / type 是 Integer，判断只能写 != null。
    -->
    <update id="update">
        UPDATE charger
        <set>
            <if test="deviceNo != null and deviceNo != ''">device_no = #{deviceNo},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="type != null">type = #{type},</if>
            <if test="model != null and model != ''">model = #{model},</if>
            <if test="ratedPowerKw != null">rated_power_kw = #{ratedPowerKw},</if>
            <if test="status != null">status = #{status},</if>
            <if test="lastHeartbeatTime != null">last_heartbeat_time = #{lastHeartbeatTime},</if>
            <if test="firmwareVersion != null and firmwareVersion != ''">firmware_version = #{firmwareVersion},</if>
            update_time = #{updateTime},
            update_user = #{updateUser}
        </set>
        WHERE id = #{id}
    </update>

    <!--
       ORDER BY id DESC，理由见 StationMapper.xml。

       stationId 走 idx_charger_station_status 的第一列；deviceNo 用前缀匹配而不是
       两侧加 % —— 设备号是运维报障时的搜索入口，%xxx% 只能全表扫。
    -->
    <select id="page" resultType="com.chargeops.entity.Charger">
        SELECT
        <include refid="Base_Column_List"/>
        FROM charger
        <where>
            <if test="stationId != null">
                AND station_id = #{stationId}
            </if>
            <if test="deviceNo != null and deviceNo != ''">
                AND device_no LIKE CONCAT(#{deviceNo}, '%')
            </if>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>
