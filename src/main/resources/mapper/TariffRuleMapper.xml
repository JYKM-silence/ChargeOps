<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chargeops.mapper.TariffRuleMapper">

    <!--
       tariff_rule 只有两个审计时间列，所以这里不能出现 #{createUser} / #{updateUser}，
       接口上也不能标 @AutoFill。两个时间列由 TariffTemplateServiceImpl.saveRules 显式
       set 后传进来。
    -->
    <sql id="Base_Column_List">
        id, template_id, period_type, start_time, end_time,
        energy_price, service_price, seq,
        create_time, update_time
    </sql>

    <!--
       ORDER BY start_time 而不是 seq：零填充的 "HH:mm:ss" 字典序 = 时间序，而
       '24:00:00' 恰好排最后 —— 末段能排在最后，本身就是它在字符串里必须写成
       '24:00:00' 的理由。
    -->
    <select id="listByTemplateId" resultType="com.chargeops.entity.TariffRule">
        SELECT
        <include refid="Base_Column_List"/>
        FROM tariff_rule
        WHERE template_id = #{templateId}
        ORDER BY start_time
    </select>

    <!--
       没有 useGeneratedKeys：tariff_rule.id 不被任何表引用，回填了也没人用。

       start_time / end_time 是 VARCHAR 传进去、MySQL 隐式转成 TIME 列。'24:00:00'
       能通过这个转换（它是有符号时长不是时刻，见 TimeCodec），但这条路径和「SQL
       字面量写 '24:00:00'」是两条不同的代码路径 —— 种子数据能存下，不能证明这里
       也能，所以测试里必须有一条断言。
    -->
    <insert id="batchInsert">
        INSERT INTO tariff_rule (template_id, period_type, start_time, end_time,
                                 energy_price, service_price, seq,
                                 create_time, update_time)
        VALUES
        <foreach collection="rules" item="r" separator=",">
            (#{r.templateId}, #{r.periodType}, #{r.startTime}, #{r.endTime},
             #{r.energyPrice}, #{r.servicePrice}, #{r.seq},
             #{r.createTime}, #{r.updateTime})
        </foreach>
    </insert>

</mapper>
