<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chargeops.mapper.MemberMapper">

    <!--
      Base_Column_List 里没有 password。需要密码的两条路径（登录的 getByPhone、
      改密码的 getByIdWithPassword）写在接口的 @Select 上，所以这里少一列不影响它们。

      效果：只要走 XML 这条路，返回的 Member 里 password 恒为 null —— 哪天有人把实体
      直接返回给前端，泄露出去的也只是一个 null 字段。
    -->

    <sql id="Base_Column_List">
        id, phone, nickname, avatar, gender, status, last_login_time,
        create_time, update_time, create_user, update_user
    </sql>

    <!--
      不写 <resultMap>：application.yml 里开了 map-underscore-to-camel-case=true，
      last_login_time 会自动映射到 lastLoginTime。理由同 StaffMapper.xml。
    -->

    <select id="getById" resultType="com.chargeops.entity.Member">
        SELECT
        <include refid="Base_Column_List"/>
        FROM member
        WHERE id = #{id}
    </select>

    <!--
       审计四列由 AutoFillInterceptor 在语句执行前填进对象，所以下面直接取
       #{createTime} 这样的属性值。

       删掉接口上的 @AutoFill 的后果是响的：全列插入时 create_time 的列名在语句里，
       传 null 就是往 NOT NULL 列里显式写 NULL → errno 1048。真正静默的只有
       create_user / update_user 这种可空列。
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO member (phone, password, nickname, avatar, gender, status, last_login_time,
                            create_time, update_time, create_user, update_user)
        VALUES (#{phone}, #{password}, #{nickname}, #{avatar}, #{gender}, #{status}, #{lastLoginTime},
                #{createTime}, #{updateTime}, #{createUser}, #{updateUser})
    </insert>

    <!--
       没有 phone、status、password 三列 —— 刻意的，另外两道防线在 DTO 和 Service 里。

       <if> 的判断分两种：nickname / avatar 是 String，写 `!= null and != ''`，空串和
       null 都表示「不改」（让空串能清空字段的话，前端一次表单没填就会把昵称抹掉）。
       gender 是 Integer，只能写 `!= null`，而且它的合法值里有 0，所以不能把 0 也
       当成「不传」。

       审计两列无条件带上：没改任何业务字段的一次 update 也应该让 update_time 前进。
    -->
    <update id="update">
        UPDATE member
        <set>
            <if test="nickname != null and nickname != ''">nickname = #{nickname},</if>
            <if test="avatar != null and avatar != ''">avatar = #{avatar},</if>
            <if test="gender != null">gender = #{gender},</if>
            update_time = #{updateTime},
            update_user = #{updateUser}
        </set>
        WHERE id = #{id}
    </update>

    <!--
       ORDER BY id DESC 是分页正确性的前提，理由见 StationMapper.xml。

       phone 用前缀匹配，两侧 % 会让 uk_member_phone 完全用不上；nickname 没有索引，
       模糊匹配注定全表扫，member 表的量级下无所谓。

       status 是 Integer，条件只能写 != null。
    -->
    <select id="page" resultType="com.chargeops.entity.Member">
        SELECT
        <include refid="Base_Column_List"/>
        FROM member
        <where>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT(#{phone}, '%')
            </if>
            <if test="nickname != null and nickname != ''">
                AND nickname LIKE CONCAT('%', #{nickname}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <!--
       这里没有对空集合的保护，SQL 层也做不出保护：`IN ()` 是语法错误，MyBatis 会拼出
       一个缺了括号体的 `IN`，MySQL 报 errno 1064 —— 而触发条件（这一页一条订单都没有）
       看起来跟 SQL 毫无关系。所以调用方必须先判空。

       不要用 <if> 把它变成「不传就查全部」：「查不到人」和「不过滤」是两件相反的事，
       后者会返回全表。
    -->
    <select id="listByIds" resultType="com.chargeops.entity.Member">
        SELECT
        <include refid="Base_Column_List"/>
        FROM member
        WHERE id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </select>

    <!--
       只取 id 不取整行：这个结果会被拼成一个 IN 列表发给订单查询。

       LIMIT 是必须的，不是优化：取到 limit 条时调用方的结论是「拒绝这次查询」而不是
       「就这么多」。前缀匹配会有多行，而调用方判断的是「是不是正好取满了」，与顺序
       无关，所以不加 ORDER BY —— 这是本文件唯一一个有意不写的查询，不要照着它去改
       别的查询。
    -->
    <select id="listIdsByPhonePrefix" resultType="java.lang.Long">
        SELECT id
        FROM member
        WHERE phone LIKE CONCAT(#{phone}, '%')
        LIMIT #{limit}
    </select>

</mapper>
