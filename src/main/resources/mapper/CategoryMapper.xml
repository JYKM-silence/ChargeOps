<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chargeops.mapper.CategoryMapper">

    <!--
      category 没有需要隐藏的列，这里是全列。
      它被 getById / listEnabled / page / insert / update 五处共用 ——
      不抽的话加一列要改五处。
    -->
    <sql id="Base_Column_List">
        id, name, type, sort, status,
        create_time, update_time, create_user, update_user
    </sql>

    <select id="getById" resultType="com.chargeops.entity.Category">
        SELECT
        <include refid="Base_Column_List"/>
        FROM category
        WHERE id = #{id}
    </select>

    <!--
      ★★ 这条才是 idx_category_type_sort (type, status, sort) 服务的那个查询。

        WHERE  type = ?         ← 索引第 1 列，等值
               status = 1       ← 索引第 2 列，等值（常量）
        ORDER BY sort           ← 索引第 3 列
        ↑ 三个位置正好对上索引的列序，所以过滤和排序全程走索引，**不产生 filesort**。

        这就是 DDL 里那句「列表查询固定是 where type=? and status=1 order by sort，
        索引顺序 (type, status, sort) 让过滤和排序都走索引」的落地处。

      ★ type 可传可不传。不传时只剩 status 一个条件，索引用不上 ——
        但那是管理端的「全部」视图，不是下拉框的主路径，可以接受。

      ★ ORDER BY 后面补了 id：sort 不是唯一键，两个 sort 相同的分类
        在两次请求里的顺序可能不同。id 唯一 → 全序 → 排序稳定。
    -->
    <select id="listEnabled" resultType="com.chargeops.entity.Category">
        SELECT
        <include refid="Base_Column_List"/>
        FROM category
        <where>
            status = 1
            <if test="type != null">
                AND type = #{type}
            </if>
        </where>
        ORDER BY sort, id
    </select>

    <!--
      新增。

      ★ sort 和 status 是 NOT NULL 且走全列插入 —— 传 null 会 errno 1048，
        不是「用上 DDL 的 DEFAULT」。默认值由 CategoryDTO 的字段初始值提供，
        Service 再兜一次（字段初始值挡不住显式的 JSON null）。

      ★ 审计四列由 AutoFillInterceptor 填，这里取属性值。
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category (name, type, sort, status,
                              create_time, update_time, create_user, update_user)
        VALUES (#{name}, #{type}, #{sort}, #{status},
                #{createTime}, #{updateTime}, #{createUser}, #{updateUser})
    </insert>

    <!--
      修改：<set> + <if> 只更新非 null 的字段。

      ★★ 注意这里**没有 type 列** —— 这是刻意的，不是遗漏。
         type 是业务事实（决定 charge_package 挂在哪个语义域），
         不是可编辑的资料。CategoryUpdateDTO 里也没有这个字段。
         完整论证见 Category 的类注释第二节。

      ★ 有 status 列：停用/启用是运营操作，随时可改。但它的语义是
        「还出不出现在下拉框里」，不是「存量数据失效」——
        停用分类不会让已挂在上面的套餐不可编辑。

      ★ 判断条件分两种（理由同 MemberMapper.xml）：
        - name 是 String，写 `!= null and != ''`
        - sort / status 是 Integer，**只能写 `!= null`**
          （和空串比较恒为 false，条件失效而 SQL 照常执行）

      ★ 审计两列无条件带上。
    -->
    <update id="update">
        UPDATE category
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null">status = #{status},</if>
            update_time = #{updateTime},
            update_user = #{updateUser}
        </set>
        WHERE id = #{id}
    </update>

    <!--
      管理端分页查询。

      ★ ORDER BY id DESC，理由同 StationMapper.xml：没有 ORDER BY 时
        MySQL 返回行的顺序是未定义的，翻页会出现重复/漏行。

      ★ name 模糊、type / status 精确。三个条件全是动态的，
        所以这条走不上 idx_category_type_sort ——
        分类是十行量级的配置表，无所谓（完整取舍见 CategoryMapper 类注释第一节）。

      ★ 不加分号、不加注释块：PageHelper 会在这条 SQL 外面套
        SELECT COUNT(*) 和 LIMIT，多余的分号会让拼接出来的语句变成语法错误。
    -->
    <select id="page" resultType="com.chargeops.entity.Category">
        SELECT
        <include refid="Base_Column_List"/>
        FROM category
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="type != null">
                AND type = #{type}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id DESC
    </select>

</mapper>
