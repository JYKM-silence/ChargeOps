<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chargeops.mapper.ConnectorMapper">

    <!--
       这张表没有 create_user / update_user，所以这里不能出现 #{createUser}，接口上
       也不能标 @AutoFill —— 插件反射找不到 setCreateUser(Long) 会抛
       IllegalStateException。两个时间列由 Service 显式 set 后传进来。
    -->
    <sql id="Base_Column_List">
        id, charger_id, station_id, gun_no, connector_type, rated_power_kw, status,
        current_order_id, total_charge_count, version,
        create_time, update_time
    </sql>

    <select id="getById" resultType="com.chargeops.entity.Connector">
        SELECT
        <include refid="Base_Column_List"/>
        FROM connector
        WHERE id = #{id}
    </select>

    <!--
       没有 current_order_id / total_charge_count / version，一律取 DDL 默认值
       （NULL / 0 / 0）：管理端的创建接口不能造出一把已被占用的枪，current_order_id
       只归订单状态机写。

       station_id 是冗余列（等于 charger.station_id），由 Service 从桩派生填入。
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO connector (charger_id, station_id, gun_no, connector_type, rated_power_kw, status,
                               create_time, update_time)
        VALUES (#{chargerId}, #{stationId}, #{gunNo}, #{connectorType}, #{ratedPowerKw}, #{status},
                #{createTime}, #{updateTime})
    </insert>

    <!--
       WHERE 里的 AND version = #{version} 是承重的：去掉它，两个并发请求后到的那个
       会静默覆盖先到的。version = version + 1 也在 SQL 侧算。

       没有 <if test="version != null">：能缺省就等于没有保护，漏传时 #{version} 绑成
       NULL，`version = NULL` 恒不成立、影响 0 行，上层报冲突。

       charger_id 不在可改列里（DTO 里也没有）：把枪挪到别的桩会让 charger.gun_count
       失真，它历史上的订单也会挂在一根不属于它的桩下面。
    -->
    <update id="update">
        UPDATE connector
        <set>
            <if test="gunNo != null and gunNo != ''">gun_no = #{gunNo},</if>
            <if test="connectorType != null and connectorType != ''">connector_type = #{connectorType},</if>
            <if test="ratedPowerKw != null">rated_power_kw = #{ratedPowerKw},</if>
            <if test="status != null">status = #{status},</if>
            update_time = #{updateTime},
            version = version + 1
        </set>
        WHERE id = #{id}
          AND version = #{version}
    </update>

    <!--
      订单状态机对枪的四个写操作。这四条是 current_order_id 的唯一写入点，判据是
      「当前占用者是不是这个订单」，和管理端 update 的 version 判据是两套。

      四条都推 version = version + 1。因为管理端 update 的 SET 里有 status：不推的话，
      管理员在充电期间把枪改成「4 故障」会成功，随后 release 的 SET status = 1 就把
      故障静默覆盖掉；推了之后他手上那个陈旧的 version 会让他的更新影响 0 行。
    -->

    <!--
       建单时抢占这把枪。这才是「一把枪同时只能有一个订单」的实现，不是建单前查一次
       charging_order 的那次 SELECT —— 那次是先查后插，两个并发请求会同时查到「没有
       进行中的订单」，然后各建一笔。条件更新的影响行数是数据库给的裁决。

       WHERE 里的 status = 1 不能省：只判 current_order_id IS NULL 的话，「4 故障」
       「5 维护」「0 离线」的枪同样能被下单。

       不要在这里写 total_charge_count —— 它归结算（见 incrementChargeCount）。
    -->
    <update id="occupy">
        UPDATE connector
        SET status = 2,
            current_order_id = #{orderId},
            version = version + 1,
            update_time = #{updateTime}
        WHERE id = #{connectorId}
          AND status = 1
          AND current_order_id IS NULL
    </update>

    <!--
      设备上报「启动成功」：2 已占用 → 3 充电中

       谓词用 current_order_id = #{orderId} 而不是 id = #{connectorId}：它同时回答了
       「这把枪现在是不是我这一单占着」。只按 id 写的话，一笔迟到的启动上报会把一把
       已经被别的订单占用的枪改成「充电中」，而那把枪上的钱是按另一笔订单冻的。
    -->
    <update id="markCharging">
        UPDATE connector
        SET status = 3,
            version = version + 1,
            update_time = #{updateTime}
        WHERE id = #{connectorId}
          AND current_order_id = #{orderId}
    </update>

    <!--
      设备上报「结束」：3 充电中 → 2 已占用

       车已经拔枪但订单还要结算，枪仍然归这一单。直接放空闲的话，结算期间别人可以下
       第二笔单，而结算正要读这把枪的起始电表读数。
    -->
    <update id="markOccupied">
        UPDATE connector
        SET status = 2,
            version = version + 1,
            update_time = #{updateTime}
        WHERE id = #{connectorId}
          AND current_order_id = #{orderId}
    </update>

    <!--
       释放（订单进入终态，或已经不再占着这把枪）

       谓词只有 current_order_id = #{orderId}，没有状态条件，所以这个方法是幂等且
       自守卫的：重复调用、或对一把从未被本单占用的枪调用都影响 0 行。正因为有这条
       性质，释放可以从 cancel / settle / markAbnormal 三处各自调用。

       SET status = 1 会覆盖管理员在此期间设的「4 故障」，这是已知且接受的：写
       CASE WHEN status IN (2,3) ... 挡它的话，管理员设过故障之后 current_order_id
       会永久留在非空状态，这把枪从此既不能删也不能再下单 —— 一个更糟的失败。
    -->
    <update id="release">
        UPDATE connector
        SET status = 1,
            current_order_id = NULL,
            version = version + 1,
            update_time = #{updateTime}
        WHERE current_order_id = #{orderId}
    </update>

    <!--
       累计充电次数 +1，由结算在同一个事务里调用。

       写成 SQL 自增，不要「先读出来再加一写回去」：后者在并发下会丢更新（两笔订单
       各自读到 5、各自写 6，实际应该是 7）。

       不推 version：这一列不在管理端 update 的 SET 里，两个方向都不会丢更新，推了
       反而让每个管理员在每次有车充完电时收到一次假冲突。上面四条恰好相反，因为
       那四条改的是 status —— 管理员也能改的列。
    -->
    <update id="incrementChargeCount">
        UPDATE connector
        SET total_charge_count = total_charge_count + 1
        WHERE id = #{connectorId}
    </update>

    <!--
       ORDER BY id DESC，理由见 StationMapper.xml。stationId 和 chargerId 各走一条
       索引的第一列，「枪冗余一份 station_id」的回报就是「这个站有哪些枪」不用
       join charger。
    -->
    <select id="page" resultType="com.chargeops.entity.Connector">
        SELECT
        <include refid="Base_Column_List"/>
        FROM connector
        <where>
            <if test="stationId != null">
                AND station_id = #{stationId}
            </if>
            <if test="chargerId != null">
                AND charger_id = #{chargerId}
            </if>
            <if test="gunNo != null and gunNo != ''">
                AND gun_no LIKE CONCAT('%', #{gunNo}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <!--
       车主端「这个站有哪些枪」—— 不过滤 status：只返回空闲的枪会让一个维护中的
       站点显示成空列表，而真相是「有 8 把枪，现在都不能用」。

       走 idx_connector_station_status 的第一列。「先可用、再按桩分组」的展示顺序是
       前端的逻辑，不固化在这里 —— 按 gun_no 排会得到 1, 10, 2。

       ORDER BY id 的唯一目的是确定性：不加它行序未定义，两次请求可能给出不同顺序，
       前端做 diff 会莫名抖动。
    -->
    <select id="listByStation" resultType="com.chargeops.entity.Connector">
        SELECT
        <include refid="Base_Column_List"/>
        FROM connector
        WHERE station_id = #{stationId}
        ORDER BY id
    </select>

    <!--
       一批站点各自的枪数 —— 一次查询覆盖整页，不是逐个 COUNT。

       SUM(status = 1) 在没有任何一行满足时返回 NULL 而不是 0（COUNT 才恒返回 0），
       所以 COALESCE 不是装饰：一个站下有 3 把枪但全是故障时，不写它会得到
       idleCount = null，界面上显示成空白而不是 0。站下没有枪时整行都不出现
       （GROUP BY 只给有匹配行的组），调用方要用「取不到就是 0」的默认值。

       别名必须和 StationConnectorCountVO 的字段名逐字对齐，改一个要改两处。
       不能传空集合，同 ChargerMapper.listByIds。
    -->
    <select id="countByStationIds" resultType="com.chargeops.vo.StationConnectorCountVO">
        SELECT station_id                              AS stationId,
               COUNT(*)                                AS connectorCount,
               COALESCE(SUM(status = 1), 0)            AS idleConnectorCount
        FROM connector
        WHERE station_id IN
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        GROUP BY station_id
    </select>

</mapper>
