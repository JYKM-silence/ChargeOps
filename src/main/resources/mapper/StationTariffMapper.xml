<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chargeops.mapper.StationTariffMapper">

    <!--
       本表四列审计字段齐全，所以 insert / update 可以标 @AutoFill —— 和
       tariff_rule / connector 相反。依据永远是「DDL 里有没有那两列」。
    -->
    <sql id="Base_Column_List">
        id, station_id, template_id, effective_from, effective_to,
        priority, status,
        create_time, update_time, create_user, update_user
    </sql>

    <select id="getById" resultType="com.chargeops.entity.StationTariff">
        SELECT
        <include refid="Base_Column_List"/>
        FROM station_tariff
        WHERE id = #{id}
    </select>

    <!--
       不写 status 条件 —— 停用的绑定也要看得见，「这个站点以前用过什么模板」只有这张
       表能回答。

       ORDER BY effective_from DESC, id DESC：最近生效的排最前；id DESC 是同一时刻的
       tiebreak。
    -->
    <select id="listByStationId" resultType="com.chargeops.entity.StationTariff">
        SELECT
        <include refid="Base_Column_List"/>
        FROM station_tariff
        WHERE station_id = #{stationId}
        ORDER BY effective_from DESC, id DESC
    </select>

    <!--
       解析「某站点在某时刻该用哪个模板」—— 下单时冻结模板调用的就是这条。四个 WHERE
       条件的列序刻意与 idx_station_tariff_lookup (station_id, status, effective_from,
       effective_to) 一致。

       effective_to 那个 IS NULL 分支是承重的：NULL 表示「长期有效」，而
       `effective_to > ?` 对 NULL 求值是 NULL（不是 true），少了这个 OR 分支，所有
       长期有效的绑定都会被静默排除掉 —— 表现是「种子里明明有一条长期绑定，解析却是
       null」。

       ORDER BY 的三个键：priority DESC 是业务裁决，后两个让同优先级时结果确定。

       不要在这条查询前调用 PageHelper.startPage：startPage 的参数放在 ThreadLocal 里、
       被本线程的下一条查询消费，一旦被它吃掉，这条语句自己的 LIMIT 1 会被覆盖成分页
       LIMIT，解析结果就依赖「上一次翻页翻到了第几页」。
    -->
    <select id="resolveTemplateAt" resultType="com.chargeops.entity.StationTariff">
        SELECT
        <include refid="Base_Column_List"/>
        FROM station_tariff
        WHERE station_id = #{stationId}
          AND status = 1
          AND effective_from &lt;= #{at}
          AND (effective_to IS NULL OR effective_to &gt; #{at})
        ORDER BY priority DESC, effective_from DESC, id DESC
        LIMIT 1
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO station_tariff (station_id, template_id, effective_from, effective_to,
                                    priority, status,
                                    create_time, update_time, create_user, update_user)
        VALUES (#{stationId}, #{templateId}, #{effectiveFrom}, #{effectiveTo},
                #{priority}, #{status},
                #{createTime}, #{updateTime}, #{createUser}, #{updateUser})
    </insert>

    <!--
       没有 station_id、没有 effective_from —— 它们参与 uk_station_tariff_start，
       改了等于换掉这条绑定的身份。

       effective_to 的 <if test="effectiveTo != null"> 有一个具体后果：没法把一条有
       期限的绑定改回「长期有效」（NULL），反方向可以。要撤销只能删掉重建。
    -->
    <update id="update">
        UPDATE station_tariff
        <set>
            <if test="templateId != null">template_id = #{templateId},</if>
            <if test="effectiveTo != null">effective_to = #{effectiveTo},</if>
            <if test="priority != null">priority = #{priority},</if>
            <if test="status != null">status = #{status},</if>
            update_time = #{updateTime},
            update_user = #{updateUser}
        </set>
        WHERE id = #{id}
    </update>

</mapper>
