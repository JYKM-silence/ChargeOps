<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chargeops.mapper.MemberPackageMapper">

    <!--
      member_package 没有需要隐藏的列，这里是全列，被三处共用。

      ★ 24 列，是库里最宽的一张表之一，这不是冗余：「按 package_type 只有一组生效」
        的这几列如果合成一个 (value, unit) 二元组，类型信息就进了数据里 ——
        结算时要先读 unit 再决定怎么算，等于把编译期的分支挪到了运行期，
        而且 SQL 层面再也无法约束「电量必须是 decimal」。
        charge_package 用同样的理由做了同样的选择。

      ★ pay_amount 是 V3 加的（23 → 24）。★ 它不在「七个类型专属列」那一组里 ——
        它对四种类型都该有值，是购买那一刻的统一快照，不是按 package_type 分支的。

      ★★ 加列时**两处都要改**：这里、以及下面 insert 的列清单和 VALUES。
        只改一处不会报错，只会让新列永远读到 null（SELECT 漏了）或者
        写入时静默丢值（INSERT 漏了）—— 后者更糟，因为它是**数据丢失**。
    -->
    <sql id="Base_Column_List">
        id, member_id, package_id, buy_order_id, package_type, package_name,
        pay_amount,
        total_kwh, remaining_kwh, total_minutes, remaining_minutes,
        total_times, remaining_times, service_discount,
        effective_from, expire_time, locked_order_id, status, remark, version,
        create_time, update_time, create_user, update_user
    </sql>

    <select id="getById" resultType="com.chargeops.entity.MemberPackage">
        SELECT
        <include refid="Base_Column_List"/>
        FROM member_package
        WHERE id = #{id}
    </select>

    <!--
      ★ 全列插入 —— DDL 的 DEFAULT 只在列**没有出现在 INSERT 里**时生效，所以
        NOT NULL 且没有默认值的列漏一个就是 errno 1048。必须由调用方给的列见
        MemberPackageMapper#insert 的 javadoc。

      ★ expire_time 没有 DEFAULT，这是刻意的：忘了填应该是 errno 1364 这种响亮的
        报错，而不是静默拿到一个「永久有效」—— 后者是能白送钱的错误。

      ★ 审计四列由 AutoFillInterceptor 反射填好之后传进来，这里只取属性值。

      ★ pay_amount **允许为 NULL**（V3 之前的老行，或者调用方真的不知道金额）——
        它和 expire_time 不一样，不填不会白送钱，只会让退款路径拒绝这一行
        （见 MemberPackage#payAmount）。所以这里**不要**给它兜一个 0：
        `#{payAmount}` 写 null 就是 NULL，那正是「不知道」的编码。
    -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO member_package (member_id, package_id, buy_order_id,
                                    package_type, package_name,
                                    pay_amount,
                                    total_kwh, remaining_kwh,
                                    total_minutes, remaining_minutes,
                                    total_times, remaining_times,
                                    service_discount,
                                    effective_from, expire_time,
                                    locked_order_id, status, remark, version,
                                    create_time, update_time, create_user, update_user)
        VALUES (#{memberId}, #{packageId}, #{buyOrderId},
                #{packageType}, #{packageName},
                #{payAmount},
                #{totalKwh}, #{remainingKwh},
                #{totalMinutes}, #{remainingMinutes},
                #{totalTimes}, #{remainingTimes},
                #{serviceDiscount},
                #{effectiveFrom}, #{expireTime},
                #{lockedOrderId}, #{status}, #{remark}, #{version},
                #{createTime}, #{updateTime}, #{createUser}, #{updateUser})
    </insert>

    <!--
      ★ 不过滤 status —— 已用尽 / 已过期 / 已作废的也要返回，让前端显示成灰态。
        滤掉的话用户会以为「我的套餐凭空消失了」。

      ★ ORDER BY status, expire_time, id 正好对上 idx_mp_member_status_expire ——
        最左列等值定位，后面两列提供有序结果，**不产生 filesort**。

      ★ 末尾的 id 不是多余的：expire_time 到毫秒，理论上仍可能重复（同一批导入的
        数据、或 expire_time 都是 9999 哨兵的永久权益）。没有唯一列收尾时，
        MySQL 对相等行的返回顺序是未定义的，前端刷新时会看到列表里的项来回跳。
    -->
    <select id="listByMember" resultType="com.chargeops.entity.MemberPackage">
        SELECT
        <include refid="Base_Column_List"/>
        FROM member_package
        WHERE member_id = #{memberId}
        ORDER BY status, expire_time, id
    </select>

    <!--
      ★★ 结算用：找「此刻可用」的权益。这段 WHERE 是整个 Mapper 最要紧的地方。★★

        status = 1                ← 状态列是缓存，**不能单独作为判据**
        locked_order_id IS NULL   ← 没被别的订单占着
        effective_from <= #{now}  ← 已经生效
        expire_time > #{now}      ← 没过期
        remaining_* > 0           ← 还有余量（按类型选对应的那一列）

      ★ 后面几条不能省：少了 effective_from，一份「下月生效」的包今天就能被抵扣；
        少了 expire_time，一份过期但没人刷新过状态的权益会被发出去；少了余量，
        一份用尽的权益会被再次选中、结算时扣成负数。三者都不会报错，只会让钱对不上。

      ★ effective_from / expire_time 是半开区间 [effective_from, expire_time)：
        生效那一刻算数，过期那一刻已经失效（`>` 而不是 `>=`，和计费时段一致）。
        时间全部由调用方从 Java 侧传入，不依赖数据库时钟。

      ★ ORDER BY expire_time ASC = 先到期的先用 —— 反过来，一份这个月过期的权益
        会被压在明年过期的后面，直到彻底作废都没被用过。排序列和上面的等值列
        （member_id, package_type）连起来，正好是 idx_mp_member_type_status 的最左三列。

      ★★ 折扣包（packageType=3）**不含余量条件**：它不消耗，没有 remaining_* 可判。
        给它加上余量判断的话，remaining 恒为 NULL，`NULL > 0` 恒不成立 ——
        折扣包**永远选不出来**，而且是静默的（查询正常返回空列表）。
        这是「NULL 参与比较恒为 NULL」的又一例。

      ★ 用 <choose> 而不是三个并列的 <if>：三种类型互斥。而且 <if> 写法在
        packageType 意外为 null 时会退化成「所有类型都不加余量条件」，
        那等于把一份用尽的权益发出去；<choose> 没有这个退化路径。
    -->
    <select id="listUsable" resultType="com.chargeops.entity.MemberPackage">
        SELECT
        <include refid="Base_Column_List"/>
        FROM member_package
        WHERE member_id = #{memberId}
          AND package_type = #{packageType}
          AND status = 1
          AND locked_order_id IS NULL
          AND effective_from &lt;= #{now}
          AND expire_time &gt; #{now}
        <choose>
            <when test="packageType == 1">
                AND remaining_kwh &gt; 0
            </when>
            <when test="packageType == 2">
                AND remaining_minutes &gt; 0
            </when>
            <when test="packageType == 4">
                AND remaining_times &gt; 0
            </when>
        </choose>
        ORDER BY expire_time, id
    </select>

    <!--
      ★ 影响行数 1 = 抢到了；0 = 被别人抢走了，调用方应回到 listUsable 取下一份重试。

      ★ locked_order_id IS NULL 看着和唯一索引重复，其实不然：唯一索引拦下冲突时
        抛的是 DuplicateKeyException，调用方要多处理一种异常；带上这个条件，正常情况下
        冲突就退化成一次普通的「影响行数 0」。唯一索引仍然是最后一道防线
        （并发的两个事务可能都通过了这个检查）。

      ★ status = 1 也带上：少了它，作废和下单并发时会出现「钱没退、权益也不能用」
        的中间状态。

      ★ 不碰 update_user —— 这是订单流程驱动的状态迁移，不是「有人编辑了记录」。
        行为人记录在 charging_order_event.source / operator_id。
    -->
    <update id="lockForOrder">
        UPDATE member_package
        SET locked_order_id = #{orderId},
            update_time = #{updateTime}
        WHERE id = #{id}
          AND locked_order_id IS NULL
          AND status = 1
    </update>

    <!--
      ★ 余量不动 —— 这是它和 settle 的唯一区别。

      ★ WHERE 里的 locked_order_id = #{orderId} 让它**幂等**，更重要的是它防住了
        一个具体的错误：一个延迟到达的释放请求（比如超时任务扫到了已经取消的订单）
        会把**另一笔订单**刚锁上的权益释放掉，那笔订单结算时 WHERE 匹配不上、
        扣不到量 —— 钱收了，量没扣，而且全程没有报错。
    -->
    <update id="releaseLock">
        UPDATE member_package
        SET locked_order_id = NULL,
            update_time = #{updateTime}
        WHERE id = #{id}
          AND locked_order_id = #{orderId}
    </update>

    <!--
      ★ 按订单号释放，**不带 id**。定位完全靠 locked_order_id = #{orderId}，
        uk_mp_locked_order 保证最多命中一行 —— 所以这条语句
        既不需要调用方先查出 memberPackageId，也不可能误伤别的订单的锁。

      ★ 谓词里只有 locked_order_id，**没有 status**，这是刻意的：
        异常挂账的来源覆盖 {1,2,3,4,6}，其中 {4,6} 的锁早被 settle 释放过 ——
        那时本语句影响 0 行。若要按 status 分支处理（「只在 1/2/3 时释放」），
        就等于把「哪几个状态还占着权益」这个知识抄一份到这里，
        而它与 OrderStatus.holdingMoneyCodes() 必然会漂移。
        影响 0 行是一个正常的、正确的答案。

      ★ 不碰 remaining_* / status：挂账的订单没结算过，权益一点没被消耗，
        释放锁之后它应该原样可用。扣量只在 settle* 里发生。
    -->
    <update id="releaseLockByOrder">
        UPDATE member_package
        SET locked_order_id = NULL,
            update_time = #{updateTime}
        WHERE locked_order_id = #{orderId}
    </update>

    <!--
      ★★★ 三个 settle 方法共用一个必须知道的 MySQL 行为 ★★★

        **SET 子句是从左到右求值的，后面的子句看到的是前面刚改完的值。**

      这不是标准 SQL（标准里所有 SET 都读原值），是 MySQL 的单表 UPDATE 语义。
      它直接决定了 status 那一行**必须写在扣量那一行之前**，而且比较的是原值：

        ✅  status = CASE WHEN remaining_kwh <= #{usedKwh} THEN 2 ELSE status END,
            remaining_kwh = remaining_kwh - #{usedKwh},
            ↑ status 先算，此时 remaining_kwh 还是原值
              「我有的 <= 你要扣的」⇔ 扣完 <= 0 ⇔ 用尽

        ❌  remaining_kwh = remaining_kwh - #{usedKwh},
            status = CASE WHEN remaining_kwh - #{usedKwh} <= 0 THEN 2 ELSE status END,
            ↑ 扣量先执行，CASE 读到的 remaining_kwh 已经减过一次，
              于是**又减了一次** —— 条件提前一步成立

      错误写法的后果（已在真库上复现）：剩余 2 次、扣 1 次之后，剩余是 1
      但 status 被置成 2（已用尽）—— 一辆车还剩 1 次没用，下一次充电
      会被静默拒绝，而前一次就已经显示「已用尽」了。

      ★ **改这三个语句时不要把 status 挪到扣量后面**，哪怕是为了「读起来更顺」。
        下面每个语句都有一行注释指着这里。
    -->

    <!--
      ★ 扣量、释放锁、用尽则改状态三件事在同一条语句里完成：拆成三条 UPDATE 的话，
        中间任何一步失败或重试都会留下不一致，最典型的是「锁释放了但量没扣」，
        表现为用户白充一次电。

      ★ status 用 CASE 而不是让调用方先查再决定 —— 判断和修改必须原子。
        用「原值 <= 扣减量」而不是「原值 - 扣减量 = 0」：理论上不该扣成负数，
        但真出现了（比如重复结算没被拦住），<= 至少能把状态标成已用尽，
        而不是留下一个负余额却仍然显示「生效中」。

      ★★ status 必须在 remaining_kwh 之前赋值，见文件上方那段说明 ★★

      ★ WHERE 里的 locked_order_id = #{orderId} 是**幂等闸门**：第一次执行后它被置为
        NULL，设备重复上报触发的第二次结算必然匹配不上，影响 0 行 —— 而不是再扣一次。
    -->
    <update id="settleEnergy">
        UPDATE member_package
        SET status = CASE WHEN remaining_kwh &lt;= #{usedKwh} THEN 2 ELSE status END,
            remaining_kwh = remaining_kwh - #{usedKwh},
            locked_order_id = NULL,
            update_time = #{updateTime}
        WHERE id = #{id}
          AND locked_order_id = #{orderId}
    </update>

    <!--
      结算：时长包。同 settleEnergy，扣的是分钟数。

      ★ 分钟数一定先取整再传进来（向上取整）—— 落库的是 int，传一个小数进来会被
        MySQL 隐式舍入，而舍入方向由数据库决定、不由业务决定。取整规则属于计费逻辑。

      ★★ status 必须在 remaining_minutes 之前赋值，见文件上方那段说明 ★★
    -->
    <update id="settleDuration">
        UPDATE member_package
        SET status = CASE WHEN remaining_minutes &lt;= #{usedMinutes} THEN 2 ELSE status END,
            remaining_minutes = remaining_minutes - #{usedMinutes},
            locked_order_id = NULL,
            update_time = #{updateTime}
        WHERE id = #{id}
          AND locked_order_id = #{orderId}
    </update>

    <!--
      ★ 没有「用了几次」参数，硬编码 1 —— 这是次卡的定义。留一个参数出来会让人
        以为可以传 2，而那个语义在业务上不存在。

      ★★ 这里是上面那个 SET 求值顺序坑最容易踩的地方，因为减数是 1：写成
        `CASE WHEN remaining_times - 1 <= 0` 的话「减 1」会被执行两次，
        **剩 1 次时就被判成已用尽**（真库上复现过）。所以比较的是原值：
        `CASE WHEN remaining_times <= 1`。
    -->
    <update id="settleTimes">
        UPDATE member_package
        SET status = CASE WHEN remaining_times &lt;= 1 THEN 2 ELSE status END,
            remaining_times = remaining_times - 1,
            locked_order_id = NULL,
            update_time = #{updateTime}
        WHERE id = #{id}
          AND locked_order_id = #{orderId}
    </update>

    <!--
      ★★ 管理端作废一份权益（退款）。这是全项目**唯一**一处「由人写入」的权益状态迁移。★★

        UPDATE member_package
           SET status = 4, remark = #{remark}, update_time = #{updateTime}
         WHERE id = #{id}
           AND status = 1
           AND locked_order_id IS NULL

      == 为什么 WHERE 里是这两个条件 ==

      ★ status = 1：只允许从「生效中」作废。少了它，重复点击第二次也影响 1 行 ——
        而那是**第二次退款**（调用方是靠影响行数决定要不要退钱的）。
        已用尽(2) / 已过期(3) 的权益也不该再走作废：它们的钱在业务上早已消耗或失效，
        给它们退款需要一个全新的口径，不是这个接口能顺手做出决定的事。

      ★ locked_order_id IS NULL：**它同时是给管理员看的守卫，也是一道并发闸门。**
        · 业务上：有一笔订单正拿着这份权益在充电（或者刚锁上还没启动），
          此刻作废会让那笔订单结算时读到一个已作废的权益；
        · 并发上：它和 lockForOrder 的谓词（locked_order_id IS NULL AND status = 1）
          形成了**互斥**。两条 UPDATE 打的是同一行，MySQL 的行锁把它们排成序 ——
          谁先提交，另一个就会看见对方的结果，于是**必然有一方影响 0 行**。
          少了这个条件的话，「作废成功」和「订单锁上这份权益」可以同时成立，
          留下一个「钱已经退了、权益还在被一笔活着的订单消费」的状态。

      ★ status 硬编码 4 而不是收参数：**这条语句就是「作废」这个迁移本身**，
        把目标状态做成参数只会多出一个「传错状态」的可能，
        而那个错误的症状是静默的（迁移仍然成功，只是迁到了一个别的状态）。

      ★ 不碰 update_user 和 version：这是状态迁移，不是「有人编辑了记录」——
        和 lockForOrder / settle* 保持一致，理由见 MemberPackageMapper 类注释第四节。
        **特别是不要推 version**：这一行上没有别的写入者在做乐观锁比较，
        推它只会让别的路径的 WHERE version = ? 莫名其妙地冲突。
        行为人记在 Services 层的日志和 remark 里。
    -->
    <update id="voidPackage">
        UPDATE member_package
        SET status = 4,
            remark = #{remark},
            update_time = #{updateTime}
        WHERE id = #{id}
          AND status = 1
          AND locked_order_id IS NULL
    </update>

    <!--
      ★ 定时任务：把过期但状态还停在 1 的权益落库成 3。见 MemberPackageExpireJob。

        UPDATE member_package
           SET status = 3, update_time = #{updateTime}
         WHERE status = 1 AND locked_order_id IS NULL AND expire_time <= #{now}
         LIMIT #{limit}

      == 三个条件各自的理由 ==

      ★ status = 1：只动「生效中」的。已用尽(2) 的不该被改写成 3 ——
        一份用完了的权益，它的故事是「你用完了」，不是「它过期了」，
        而这个区别会出现在车主端的灰态文案和运营的过期统计里。

      ★ locked_order_id IS NULL：**不打扰一笔正在进行的订单。**
        订单在 create 时锁定这份权益，那一刻它是有效的；如果它恰好在充电期间过期，
        结算时 applyPackage 会读到 status = 3 然后「按无优惠结算」——
        用户看到的价格和他建单时看到的预估不是同一个。
        一份被锁着的权益**这一轮不动**，等那笔订单结算释放锁之后，
        下一轮扫描会自然把它落库（收敛性来自「锁一定会被释放」，见
        ChargingOrderServiceImpl.markAbnormal 里那段 releasePackageLock）。

      ★ expire_time <= #{now}：**这是本语句存在的理由**。status 是缓存，
        expire_time 才是真相（见 MemberPackageStatus 类注释）。
        用 <= 而不是 <：过期那一刻就已经失效，和 listUsable 的
        `expire_time > #{now}` 正好互补，两条路径的边界必须严丝合缝 ——
        差一个等号会留下一毫秒的窗口，那时这份权益在对账上既算「没过期」
        又算「已过期」。两边的时间都来自调用方从 Java 侧传入的同一个 now。

      ★ LIMIT #{limit}：**必须要有上限**。这是一个会随数据量线性劣化的语句，
        而积压时的第一轮可能面对几十万行 —— 不加 LIMIT 就是一条长事务，
        它持有大量行锁直到提交，而此刻真实的用户在买套餐、在结算。
        剩下的下一轮会处理掉（fixedDelay 保证不会自我重叠）。
        和 ChargingOrderSweepJob 的 payTimeoutBatchSize 是同一条理由。

      ★ 没有 ORDER BY：这一批里先处理哪几行**是无所谓的** ——
        它们全都是「已经过期、状态没跟上」的同一类行，挑不出优先级来。
        加一个 ORDER BY 只会引入一次排序开销，换来一个不存在的公平性。

      ★ 走 idx_mp_status_expire (status, expire_time)（V3 建的）——
        status 等值 + expire_time 范围，正好是那条索引的两列。
        不要改谓词里的列顺序或加列，那会让它退回全表扫描。
    -->
    <update id="expireOverdue">
        UPDATE member_package
        SET status = 3,
            update_time = #{updateTime}
        WHERE status = 1
          AND locked_order_id IS NULL
          AND expire_time &lt;= #{now}
        LIMIT #{limit}
    </update>

</mapper>
