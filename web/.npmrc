# 本机 node 26 / pnpm 11 都很新，部分依赖的 engines 字段会落后于现实。
# 默认情况下 pnpm 对不满足的 engines 只是告警，但 engine-strict=true 会直接拒绝安装；
# 这里显式关掉，避免「装不上」而不是「装上了但有告警」。
engine-strict=false

# 未声明的 peer 依赖一律告警而不要中断安装。
# 典型场景：vue-router 5 把 vite / @pinia/colada 列为 peer，
# pinia 4 把 @vue/devtools-api 列为 peer —— 前者我们本就有，后者只在 devtools 里用得上。
strict-peer-dependencies=false

# 让 workspace 内的包用符号链接互相引用（@chargeops/shared 靠这个被两个 app 消费）。
link-workspace-packages=true

# 走国内镜像。默认的 registry.npmjs.org 在这台机器上实测很慢
# （一次 `npm view` 要 2 分钟以上），装三个包的依赖会到难以接受的程度。
# ★ 想换回官方源：删掉这一行，然后 `pnpm install --force` 重新解析并重写 lockfile。
registry=https://registry.npmmirror.com/
